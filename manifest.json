{
  "manifest_version": 3,
  "name": "Video Pro Finder",
  "description": "Find, preview, and save playable video sources from the current page.",
  "version": "1.0.0",
  "minimum_chrome_version": "96",
  "permissions": ["activeTab", "storage", "downloads", "contextMenus", "scripting", "notifications"],
  "optional_host_permissions": ["<all_urls>"],
  "action": {
    "default_title": "Video Pro Finder",
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/ultimate-krypton-icon.svg",
      "32": "icons/ultimate-krypton-icon.svg",
      "48": "icons/ultimate-krypton-icon.svg",
      "128": "icons/ultimate-krypton-icon.svg"
    }
  },
  "icons": { "16": "icons/ultimate-krypton-icon.svg", "32": "icons/ultimate-krypton-icon.svg", "48": "icons/ultimate-krypton-icon.svg", "128": "icons/ultimate-krypton-icon.svg" },
  "background": { "service_worker": "background.js", "type": "module" },
  "options_page": "options.html",
  "web_accessible_resources": [{ "resources": ["lib/*"], "matches": ["<all_urls>"] }]
}